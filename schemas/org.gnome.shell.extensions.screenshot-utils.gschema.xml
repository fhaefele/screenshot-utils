<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.screenshot-utils" path="/org/gnome/shell/extensions/screenshot-utils/">
    <key name="save-location" type="s">
      <default>'~/Pictures'</default>
      <summary>Screenshot folder</summary>
      <description>Folder for saved captures. Initialized to the Pictures folder; cannot be empty.</description>
    </key>
    <key name="filename-template" type="s">
      <default>'Screenshot-{Y}-{m}-{d}-{H}{M}{S}'</default>
      <summary>Filename template</summary>
      <description>Supports {date}, {time}, {type}, {Y}, {m}, {d}, {H}, {M}, {S}, and {N}.</description>
    </key>
    <key name="capture-delay-ms" type="i">
      <default>0</default>
      <range min="0" max="30000"/>
      <summary>Capture delay in milliseconds</summary>
    </key>
    <key name="show-notifications" type="b">
      <default>true</default>
      <summary>Show capture notifications</summary>
    </key>
    <key name="include-cursor" type="b">
      <default>false</default>
      <summary>Include the pointer</summary>
    </key>
    <key name="copy-to-clipboard" type="b">
      <default>false</default>
      <summary>Copy the screenshot image to the clipboard</summary>
    </key>
    <key name="shortcuts-enabled" type="b">
      <default>false</default>
      <summary>Enable keyboard shortcuts</summary>
      <description>Enable the chosen shortcut source. Turning off cancels pending shortcut captures.</description>
    </key>
    <key name="shortcut-setup" type="s">
      <default>''</default>
      <choices><choice value=""/><choice value="gnome"/><choice value="extension"/></choices>
      <summary>Shortcut setup</summary>
    </key>
    <key name="ask-command-confirmation" type="b">
      <default>true</default>
      <summary>Ask before screenshots from commands</summary>
      <description>When true, confirm each screenshot command. When false, any local application can take screenshots by invoking the commands. This choice persists across logins and Shell restarts.</description>
    </key>
    <key name="shortcut-selection" type="s">
      <default>''</default>
      <summary>Selection shortcut</summary>
    </key>
    <key name="shortcut-screen" type="s">
      <default>''</default>
      <summary>Screen shortcut</summary>
    </key>
    <key name="shortcut-window" type="s">
      <default>''</default>
      <summary>Window shortcut</summary>
    </key>
    <key name="shortcut-status" type="a{ss}">
      <default>{}</default>
      <summary>Shortcut registration feedback</summary>
    </key>
    <key name="mute-screenshot-sound" type="b">
      <default>false</default>
      <summary>Mute the screenshot capture sound</summary>
    </key>
  </schema>
</schemalist>
